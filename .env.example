# Web workspace (`apps/web`) — copy to `apps/web/.env.local` for local development.
# Convex and authentication
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=
REPOPRESS_CAPABILITY_SECRET=

# Compatible product preview (matched P-256 key pair)
NEXT_PUBLIC_PREVIEW_ORIGIN=
NEXT_PUBLIC_PREVIEW_APPROVAL_PUBLIC_KEY_JWK=
PREVIEW_APPROVAL_PRIVATE_KEY_JWK=
